{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SentinelGate.ThreatDetection": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5003"
      }
    }
  },
  "ThreatDetection": {
    "Enabled": true,
    "MonitorThreshold": 31.0,
    "CaptchaThreshold": 31.0,
    "ThrottleThreshold": 60.0,
    "TemporaryBlockThreshold": 80.0,
    "PermanentBlockThreshold": 90.0,
    "AutoBlockThreshold": 90.0,
    "DecayHalfLifeHours": 24.0,
    "RateLimitViolationWeight": 15,
    "High4xxRateWeight": 20,
    "AuthFailureWeight": 25,
    "SingleEndpointHammeringWeight": 20,
    "UserAgentAnomalyWeight": 10,
    "GeoMismatchWeight": 10,
    "PayloadAnomalyWeight": 15
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
